      {
        "name": "teach-back",
        "prompt": "explain the section's key idea (e.g. closures, pattern matching) to a JS developer in 2 minutes, with one SML and one JS example"
      },
      {
        "name": "predict",
        "prompt": "read 5 short SML snippets, predict type and value before running them"
      }
    ]
  },
  "pace": {
    "gate_fraction": 0.6,
    "drop_ladder": [
